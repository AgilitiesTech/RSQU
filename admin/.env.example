# Required
ADMIN_PASSWORD=choose-a-long-password
# Public address of this dashboard, used in payment and proposal links
BASE_URL=https://rsqu-admin.onrender.com
# Website(s) allowed to send requests here
ALLOWED_ORIGINS=https://agilitiestech.github.io
# Where the database and customer photos live (mount a persistent disk here)
DATA_DIR=./data
# Optional: keeps logins valid across restarts if you move servers
SESSION_SECRET=

# Card and bank payments (Stripe). Use sk_test_... until you've tried it end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only when Mike's Stripe account is connected to an Agilities platform account:
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_APPLICATION_FEE_BP=0

# Optional text alerts to Mike for new requests, signatures and payments (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=+18012324995
