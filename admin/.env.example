# Required
SUPER_ADMIN_EMAIL=aaron@agilitiestech.com
SUPER_ADMIN_PASSWORD=choose-a-long-password
BASE_URL=https://gethitchpoint.com
# Marketing domain for the HitchPoint landing page (canonical URL, sitemap)
PLATFORM_URL=https://gethitchpoint.com
# Gets lead and sign-up alerts
PLATFORM_CONTACT_EMAIL=aaron@agilitiestech.com
# Optional: text alerts for new leads
PLATFORM_NOTIFY_PHONE=
DATA_DIR=./data
# Optional: keeps logins valid if you move servers
SESSION_SECRET=

# Stripe (HitchPoint platform account). Each business gets its OWN Stripe account (Accounts v2)
# and customers pay it directly: the business is the merchant of record.
STRIPE_SECRET_KEY=
# Webhook for your account's events (checkout.session.*). Only needed while payments taken
# under the old platform-charge model are still settling.
STRIPE_WEBHOOK_SECRET=
# Webhook for connected accounts' events: account.updated, checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: API version for v2 requests (default 2026-10-28.endive)
STRIPE_API_VERSION=
# Optional: set to off to stop requesting ACH Direct Debit on new business accounts
STRIPE_ACH_PAYMENTS=

# Optional: drafts proposals from job photos (Anthropic Claude API). Without it, photo quotes keep
# the photos and the technician adds the lines.
ANTHROPIC_API_KEY=
# Optional: model for photo drafts (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Optional: text alerts and customer receipts by text (Twilio). US texting needs A2P 10DLC registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: password reset and receipt emails (Resend). EMAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
