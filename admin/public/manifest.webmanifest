{
  "name": "HitchPoint",
  "short_name": "HitchPoint",
  "description": "Requests, schedule, quotes and payments for your repair business.",
  "id": "/admin/",
  "start_url": "/admin/#/requests",
  "scope": "/admin/",
  "display": "standalone",
  "background_color": "#F6F3EE",
